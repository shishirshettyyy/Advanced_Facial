# ============================================================
# Smart Attendance CV Service - Environment Variables
# Copy this to .env and fill in your values
# ============================================================

# Service port
PORT=8001

# Node.js backend base URL
NODE_BACKEND_URL=http://localhost:5000

# Shared secret for internal API calls (must match Node.js side)
INTERNAL_SECRET=change_this_to_a_long_random_secret

# Face recognition backend: insightface | deepface | face_recognition | opencv
# Start with 'deepface'; fall back to 'opencv' if TF is unavailable on Python 3.14
FACE_RECOGNITION_BACKEND=deepface

# Minimum cosine similarity to count as a match (0.0–1.0)
CONFIDENCE_THRESHOLD=0.6

# How many consecutive frame confirmations before emitting a recognition event
MIN_FACE_CONFIRMATIONS=3

# Maximum simultaneous RTSP camera streams
MAX_CAMERAS=10

# Skip every N frames to reduce CPU load (1 = process every frame)
FRAME_SKIP=2

# Logging level: DEBUG | INFO | WARNING | ERROR
LOG_LEVEL=INFO

# Directories (relative paths are resolved from the project root)
MODELS_DIR=./models
UPLOADS_DIR=./uploads

# CORS allowed origins (comma-separated)
CORS_ORIGINS=http://localhost:5000,http://localhost:3000

# Environment label: development | production
ENVIRONMENT=development
